# =========================
# PostgreSQL
# =========================
POSTGRES_USER=nids
POSTGRES_PASSWORD=nids_dev_password
POSTGRES_DB=nids
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://nids:nids_dev_password@postgres:5432/nids

# =========================
# FastAPI
# =========================
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
API_CORS_ORIGINS=["http://localhost:3000"]

# =========================
# MLflow
# =========================
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_BACKEND_STORE_URI=sqlite:///mlflow/mlflow.db
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts

# =========================
# Next.js
# =========================
NEXT_PUBLIC_API_URL=http://localhost:8000
